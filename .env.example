# W9 Database Environment Variables
# Copy this file to .env and fill in the values

# GitHub Container Registry username
GITHUB_USER=w9labs

# Database Configuration
DATABASE_URL=memory
# For persistent: DATABASE_URL=rocksdb:///app/data/w9-db

# JWT Configuration
JWT_SECRET=change-me-in-production-use-long-random-string

# OAuth / OIDC Configuration
ISSUER_URL=https://db.w9.nu

# Default Admin Credentials (change in production!)
DEFAULT_ADMIN_EMAIL=admin@w9.nu
DEFAULT_ADMIN_PASSWORD=W9AdminSecure123!

# Server Configuration
PORT=8082
HOST=0.0.0.0

# Docker Ports
W9_DB_PORT=8082
